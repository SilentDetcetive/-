--- !u!114 &1014189734
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1014189732}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u7AEF\u70B9\u5165\u4FB5\xB7\u64CD\u4F5C\u5907\u5FD8\u5F55\n\n---\n\n\u79FB\u52A8\n\nWASD\u63A7\u5236\u65B9\u5411\u3002\u79FB\u52A8\u6CBF\u8DEF\u5F84\u4E2D\u7EBF\u8FDB\u884C\uFF0C\u677E\u5F00\u6309\u952E\u5373\u81EA\u52A8\u505C\u5728\u5F53\u524D\u65B9\u683C\u4E2D\u5FC3\uFF0C\u4E0D\u5FC5\u624B\u52A8\u5BF9\u9F50\u3002\u9F20\u6807\u8D1F\u8D23\u89C2\u5BDF\uFF0C\u63D0\u524D\u770B\u62D0\u89D2\u540E\u9762\u7684\u60C5\u51B5\u3002\n\n\u6838\u5FC3\u89C4\u5219\n\n\u8EAB\u540E\u8DEF\u5F84\u4F1A\u88AB\u7CFB\u7EDF\u9010\u6B65\u7194\u6BC1\uFF0C\u9ED1\u8272\u533A\u57DF\u4E0D\u53EF\u901A\u884C\u3002\u7194\u6BC1\u901F\u5EA6\u968F\u65F6\u95F4\u9012\u589E\uFF0C\u521D\u59CB\u6162\uFF0C\u6BCF\u8FC7\u4E00\u4E2A\u9636\u6BB5\u7FFB\u500D\u52A0\u901F\u3002\u6240\u4EE5\u4E0D\u80FD\u505C\uFF0C\u4E5F\u4E0D\u80FD\u56DE\u5934\u3002\n\n\u9053\u5177\u601D\u8DEF\n\n\u6709\u8272\u5899\u9700\u8981\u5BF9\u5E94\u989C\u8272\u7684\u62DF\u6001\u7403\u624D\u80FD\u7A7F\u8FC7\u3002\u767D\u8272\u969C\u788D\u65B9\u5757\u9700\u8981\u5403\u8FDB\u9636\u6A21\u5757\u63D0\u5347\u7B49\u7EA7\u540E\u649E\u788E\u2014\u2014\u6CE8\u610F\u4F53\u79EF\u53D8\u5927\u540E\u53EF\u80FD\u5361\u4F4F\u7A84\u8DEF\uFF0C\u5403\u7684\u987A\u5E8F\u8981\u63D0\u524D\u60F3\u597D\u3002\u4F20\u9001\u95E8\u6210\u5BF9\u5B58\u5728\uFF0C\u989C\u8272\u76F8\u540C\uFF0C\u8D70\u8FC7\u53BB\u76F4\u63A5\u8DF3\u5230\u53E6\u4E00\u7AEF\uFF0C\u524D\u63D0\u662F\u76EE\u6807\u90A3\u8FB9\u8FD8\u6CA1\u88AB\u7194\u6BC1\u3002\u7BA1\u7406\u5458\u5BC6\u94A5\u7ED9\u5341\u79D2\u5168\u5C40\u89C6\u91CE\uFF0C\u7528\u6765\u8BB0\u8DEF\u7EBF\u3002\n\n\u6269\u5BB9\u6A21\u5757\u52A0\u5BB9\u91CF\u4E0A\u9650\uFF0C\u4F18\u5148\u62FF\u3002\n\n\u4EBA\u683C\u9009\u62E9\n\n\u5E26\u4EC0\u4E48\u53D6\u51B3\u4E8E\u5173\u5361\u9700\u6C42\u3002\u9700\u8981\u89C6\u91CE\u5C31\u9009\u5F00\u5C40\u5E26\u5BC6\u94A5\u7684\uFF0C\u9700\u8981\u901F\u5EA6\u5C31\u9009\u5E26\u589E\u901F\u6A21\u5757\u7684\uFF0C\u60F3\u7A33\u5C31\u5E26\u6269\u5BB9\u5F00\u5C40\u3002\u7CFB\u7EDF\u5BB9\u91CF\u7BA1\u7740\u80FD\u540C\u65F6\u62FF\u51E0\u4E2A\u9053\u5177\uFF0C\u4E0D\u591F\u5C31\u627E\u6269\u5BB9\u6A21\u5757\u8865\u3002\n\n\u654C\u4EBA\n\n\u5DE1\u903B\u5355\u4F4D\u6CBF\u56FA\u5B9A\u8DEF\u7EBF\u8D70\uFF0C\u770B\u5230\u6211\u5C31\u8FFD\u3002\u68C0\u75AB\u5355\u4F4D\u4F1A\u7ED9\u6240\u6709\u654C\u4EBA\u62A5\u6211\u7684\u4F4D\u7F6E\u3002\u88AB\u6807\u8BB0\u4E4B\u540E\u7ED5\u8DEF\uFF0C\u522B\u786C\u95EF\u3002\u9690\u8EAB\u6A21\u5757\u80FD\u9A97\u8FC7\u8B66\u6212\u533A\uFF0C\u683C\u5F0F\u5F39\u7559\u7ED9\u8FFD\u5F97\u6700\u8FD1\u7684\u90A3\u4E2A\uFF0C\u6253\u4E2D\u4E4B\u540E\u5BF9\u65B9\u865A\u5316\u516D\u79D2\uFF0C\u76F4\u63A5\u7A7F\u8FC7\u53BB\u3002\n\n\u6700\u540E\n\n\u8DEF\u4E0A\u4F1A\u6361\u5230\u672A\u9001\u8FBE\u7684\u6570\u636E\u5305\u88F9\u3002\u6CA1\u6709\u589E\u76CA\uFF0C\u4E0D\u5360\u683C\u5B50\u3002\u7EC8\u70B9\u7AD9\u4F1A\u95EE\u7559\u4E0B\u8FD8\u662F\u5E26\u8D70\u3002\n\n\u6BCF\u6B21\u90FD\u5E26\u8D70\u3002\n\n\u4E0D\u4E3A\u4EC0\u4E48\u3002"
