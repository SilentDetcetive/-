    m_Alignment: 3
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 1
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "\u3010\u201C\u6CDB\u8054\u201D\u9879\u76EE\u539F\u5740 \xB7 \u5DE5\u7A0B\u72B6\u6001\u62A5\u544A
    \xB7 \u81EA\u52A8\u751F\u6210\u3011\r\n\r\n\u8BBE\u65BD\u540D\u79F0\uFF1A\u6CDB\u8054\u5206\u53D1\u7F51\u7EDC\u4E2D\u7EE7\u8282\u70B9\uFF08\u8BD5\u8FD0\u884C\u6BB5\uFF09\r\n\u4F4D\u7F6E\uFF1A\u5A31\u4E50\u79D1\u8F96\u533AE-11\u81F3E-14\u533A\u57DF\r\n\u8BBE\u65BD\u72B6\u6001\uFF1A\u5DF2\u5EFA\u6210\uFF0C\u65E0\u9650\u671F\u4E2D\u6B62\u8FD0\u884C\r\n\r\n\u8BE5\u8BD5\u8FD0\u884C\u6BB5\u4E8E\u7B2C1103\u5468\u671F\u5EFA\u6210\uFF0C\u542B3\u4E2A\u5206\u53D1\u4E2D\u7EE7\u8282\u70B9\u53CA1\u6761\u72EC\u7ACB\u4F20\u8F93\u94FE\u8DEF\u3002\u8BD5\u8FD0\u884C\u671F\u95F4\u5171\u6210\u529F\u4F20\u8F93\u5A31\u4E50\u5185\u5BB9\u7EA60.3PB\uFF0C\u8986\u76D6\u5468\u8FB9\u533A\u57DF\u7EA68000\u5C45\u6C11\u3002\u5728\u9879\u76EE\u88AB\u4E2D\u6B62\u7684\u5F53\u5929\uFF0C\u6700\u540E\u4E00\u4E2A\u901A\u8FC7\u8BE5\u94FE\u8DEF\u4F20\u8F93\u7684\u6570\u636E\u5305\u662F\u4E00\u6BB5\u201C\u661F\u5149\u201D\u7CFB\u5217\u5168\u606F\u6F14\u51FA\u5F55\u50CF\u7684\u7247\u6BB5\u3002\u8BE5\u6570\u636E\u5305\u672A\u80FD\u5B8C\u6210\u5168\u90E8\u4F20\u8F93\u2014\u2014\u94FE\u8DEF\u5728\u88AB\u5173\u95ED\u7684\u77AC\u95F4\u5207\u65AD\u4E86\u6D41\uFF0C\u88AB\u4F20\u8F93\u7684\u5185\u5BB9\u5B9A\u683C\u5728\u67D0\u4E00\u5E27\uFF1A\u4E00\u4E2A\u865A\u62DF\u5076\u50CF\u6B63\u5F00\u53E3\u51C6\u5907\u5531\u6B4C\uFF0C\u5634\u5DF4\u6C38\u8FDC\u672A\u80FD\u5408\u4E0A\u3002\r\n\r\n\u8BBE\u65BD\u7EF4\u62A4\u72B6\u6001\uFF1A\u81EA\u52A8\u7EF4\u62A4\u7CFB\u7EDF\u5DF2\u4E8E\u7B2C1140\u5468\u671F\u56E0\u7F3A\u4E4F\u9884\u7B97\u8865\u7ED9\u800C\u505C\u6B62\u8FD0\u884C\u3002\u8BBE\u65BD\u5F53\u524D\u5904\u4E8E\u81EA\u7136\u635F\u8017\u72B6\u6001\u3002\r\n\r\n\u6700\u8FD1\u4E00\u6B21\u6709\u4EBA\u7ECF\u8FC7\u6B64\u5904\u662F\u5728\u7B2C1143\u5468\u671F\u3002\u4E00\u540D\u5916\u56F4\u5C45\u6C11\u7559\u4E0B\u4E86\u4E00\u884C\u624B\u5199\u7684\u5B57\u8FF9\uFF0C\u523B\u5728\u4E2D\u7EE7\u8282\u70B9\u5916\u58F3\u4E0A\uFF1A\u201C\u6211\u4EEC\u8FD8\u5728\u7B49\u90A3\u9996\u6B4C\u3002\u201D"
