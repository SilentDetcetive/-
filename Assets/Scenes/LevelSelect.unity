--- !u!114 &1580643416
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1580643414}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 12800000, guid: d1c9582d44267bd48ae0158198e69019, type: 3}
    m_FontSize: 50
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 5
    m_MaxSize: 50
    m_Alignment: 3
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 1
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "\u3010\u5A31\u4E50\u79D1\u5185\u5BB9\u5236\u4F5C\u7F72 \xB7 \u865A\u62DF\u5076\u50CF\u201C\u661F\u5149\u201D\u7CFB\u5217\u5B63\u5EA6\u8FD0\u8425\u62A5\u544A\uFF08\u5BF9\u5916\u516C\u5F00\u7248\uFF09\u3011\r\n\r\n\u672C\u5B63\u5EA6\u201C\u661F\u5149\u201D\u7CFB\u5217\u865A\u62DF\u5076\u50CF\u5171\u5B8C\u6210\uFF1A\r\n\xB7
    \u5168\u606F\u6F14\u51FA42\u573A\uFF08\u5176\u4E2D\u9762\u5411\u6838\u5FC3\u533A\u57DF\u8BA2\u9605\u7528\u623736\u573A\uFF0C\u9762\u5411\u4E2D\u5C42\u533A\u57DF4\u573A\uFF0C\u9762\u5411\u5916\u56F4\u533A\u57DF2\u573A\uFF09\uFF1B\r\n\xB7
    \u65B0\u66F2\u76EE\u5236\u4F5C9\u9996\uFF1B\r\n\xB7 \u89D2\u8272\u6A21\u578B\u66F4\u65B0\u8FED\u4EE34\u6B21\uFF08\u542B\u53D1\u4E1D\u6E32\u67D3\u7CBE\u5EA6\u63D0\u5347\u3001\u5FAE\u8868\u60C5\u7CFB\u7EDF\u5347\u7EA7\u3001\u5B9E\u65F6\u5BF9\u8BDD\u6A21\u5757\u6269\u5BB9\uFF09\u3002\r\n\r\n\u672C\u5B63\u5EA6\u8FD0\u8425\u6210\u672C\u5408\u8BA1\uFF1A\u7EA6380\u914D\u7ED9\u5355\u4F4D\uFF08\u542B\u7B97\u529B\u79DF\u8D41\u3001\u5E26\u5BBD\u5360\u7528\u3001\u5236\u4F5C\u56E2\u961F\u7EF4\u6301\u8D39\u7528\uFF09\u3002\u8BA2\u9605\u6536\u5165\u5408\u8BA1\uFF1A\u7EA6410\u914D\u7ED9\u5355\u4F4D\u3002\u8FDE\u7EED\u7B2C\u4E09\u4E2A\u5B63\u5EA6\u5B9E\u73B0\u76C8\u4F59\u3002\r\n\r\n\u5185\u5BB9\u5236\u4F5C\u7F72\u540C\u65F6\u56DE\u5E94\u90E8\u5206\u5185\u90E8\u5458\u5DE5\u7684\u5173\u5207\uFF1A\u5236\u4F5C\u56E2\u961F\u63D0\u51FA\u7684\u201C\u516C\u76CA\u6F14\u51FA\u8BA1\u5212\u201D\uFF08\u9762\u5411\u5916\u56F4\u533A\u57DF\u7684\u514D\u8D39\u5DE1\u6F14\uFF09\u5DF2\u5728\u5185\u5BB9\u6392\u671F\u4E2D\u9884\u7559\u4F4D\u7F6E\u3002\u5177\u4F53\u6392\u671F\u5C06\u89C6\u9884\u7B97\u60C5\u51B5\u53E6\u884C\u516C\u5E03\u3002\r\n\r\n\uFF08\u201C\u516C\u76CA\u6F14\u51FA\u8BA1\u5212\u201D\u81EA\u7B2C1138\u5468\u671F\u8D77\u5728\u6BCF\u4EFD\u5B63\u5EA6\u62A5\u544A\u7684\u672B\u5C3E\u88AB\u63D0\u53CA\uFF0C\u9884\u7559\u4F4D\u7F6E\u81F3\u4ECA\u672A\u88AB\u586B\u5145\u3002\uFF09"
