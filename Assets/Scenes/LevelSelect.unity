    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "\u3010\u5A31\u4E50\u79D1\u5185\u5BB9\u7BA1\u7406\u7F72 \xB7 \u672A\u5206\u53D1\u5185\u5BB9\u5B63\u5EA6\u62A5\u544A\uFF08\u6458\u8981\uFF09\u3011\r\n\r\n\u622A\u81F3\u7B2C1147\u5468\u671F\u672B\uFF0C\u5A31\u4E50\u79D1\u5DF2\u5236\u4F5C\u5B8C\u6210\u4F46\u5C1A\u672A\u5206\u53D1\u7684\u5A31\u4E50\u5185\u5BB9\u603B\u91CF\u8FBE\u5230\u521B\u7EAA\u5F55\u768414.7PB\u3002\u5176\u4E2D\uFF1A\r\n\r\n\xB7
    \u5168\u606F\u6F14\u51FA\u5F55\u50CF\uFF08\u542B\u5DF2\u5F55\u5236\u672A\u64AD\u51FA\u7684\u6F14\u51FA\uFF09\u5408\u8BA18.3PB\uFF1B\r\n\xB7
    \u4E92\u52A8\u53D9\u4E8B\u5185\u5BB9\uFF08\u542B\u5DF2\u5B8C\u6210\u672A\u4E0A\u7EBF\u7684\u5267\u672C\uFF09\u5408\u8BA13.2PB\uFF1B\r\n\xB7
    \u865A\u62DF\u5076\u50CF\u89D2\u8272\u6570\u636E\u66F4\u65B0\u5305\u5408\u8BA12.1PB\uFF1B\r\n\xB7
    \u5176\u4ED6\u5A31\u4E50\u5185\u5BB9\u5408\u8BA11.1PB\u3002\r\n\r\n\u4E0A\u8FF0\u5185\u5BB9\u5DF2\u901A\u8FC7\u5B8C\u6574\u6027\u6821\u9A8C\uFF0C\u5177\u5907\u5373\u65F6\u5206\u53D1\u6761\u4EF6\u3002\u5F53\u524D\u5EF6\u8FDF\u5206\u53D1\u7684\u4E3B\u8981\u56E0\u7D20\u4E3A\u5206\u53D1\u7F51\u7EDC\u7684\u5E26\u5BBD\u8D44\u6E90\u5206\u914D\u4F18\u5148\u7EA7\u2014\u2014\u6838\u5FC3\u533A\u57DF\u7684\u5B9E\u65F6\u6F14\u51FA\u4FDD\u969C\u4E0E\u865A\u62DF\u5076\u50CF\u540C\u6B65\u66F4\u65B0\u5360\u636E\u4E86\u53EF\u7528\u5E26\u5BBD\u7684\u7EDD\u5927\u90E8\u5206\u3002\r\n\r\n\u5185\u5BB9\u7BA1\u7406\u7F72\u5DF2\u5411\u8D44\u6E90\u8C03\u914D\u7F72\u63D0\u4EA4\u4E86\u300A\u5173\u4E8E\u5229\u7528\u975E\u5CF0\u503C\u65F6\u6BB5\u8FDB\u884C\u5916\u56F4\u533A\u57DF\u5185\u5BB9\u5206\u53D1\u7684\u53EF\u884C\u6027\u62A5\u544A\u300B\u3002\u62A5\u544A\u76EE\u524D\u5904\u4E8E\u5BA1\u6838\u72B6\u6001\u3002\r\n\r\n\uFF08\u672C\u62A5\u544A\u63D0\u4EA4\u65E5\u671F\uFF1A\u7B2C1140\u5468\u671F\u3002\u5BA1\u6838\u72B6\u6001\u81F3\u4ECA\u65E0\u66F4\u65B0\u3002\uFF09\r\n"
