    m_LineSpacing: 1
  m_Text: "\u3010\u5A31\u4E50\u79D1\u8D44\u6E90\u8C03\u914D\u7F72 \xB7 \u7CFB\u7EDF\u81EA\u52A8\u901A\u544A\u3011\r\n\r\n\u672C\u6D88\u606F\u7531\u5A31\u4E50\u79D1\u8D44\u6E90\u8C03\u914D\u7F72\u81EA\u52A8\u901A\u544A\u7CFB\u7EDF\u751F\u6210\uFF0C\u53D1\u9001\u7ED9\u6240\u6709\u5728\u8D44\u6E90\u8C03\u914D\u7CFB\u7EDF\u4E2D\u89E6\u53D1\u201C\u7EC8\u70B9\u7AEF\u53E3\u201D\u4E8B\u4EF6\u7684\u64CD\u4F5C\u8005\u3002\r\n\r\n\u64CD\u4F5C\u8005\u60A8\u597D\u3002\r\n\r\n\u7CFB\u7EDF\u68C0\u6D4B\u5230\u60A8\u5DF2\u63A5\u8FD1\u5F53\u524D\u8BBF\u95EE\u8DEF\u5F84\u7684\u7EC8\u70B9\u3002\u65E0\u8BBA\u60A8\u5728\u6B64\u6B21\u8BBF\u95EE\u4E2D\u7ECF\u5386\u4E86\u4EC0\u4E48\uFF0C\u7CFB\u7EDF\u6709\u4E49\u52A1\u544A\u77E5\u60A8\u4EE5\u4E0B\u4E8B\u9879\uFF1A\r\n\r\n\u60A8\u6216\u8BB8\u6CE8\u610F\u5230\uFF0C\u60A8\u7A7F\u8D8A\u7684\u8DEF\u5F84\u4E2D\u6709\u4E00\u90E8\u5206\u5448\u73B0\u4E3A\u6C38\u4E45\u6027\u7684\u9ED1\u8272\u2014\u2014\u90A3\u662F\u88AB\u8DEF\u5F84\u7834\u574F\u673A\u5236\u6E05\u9664\u540E\u7684\u533A\u57DF\u3002\u8FD9\u4E9B\u533A\u57DF\u66FE\u7ECF\u662F\u5206\u53D1\u94FE\u8DEF\u7684\u4E00\u90E8\u5206\uFF0C\u66FE\u7ECF\u627F\u8F7D\u8FC7\u88AB\u4F20\u8F93\u7684\u5A31\u4E50\u5185\u5BB9\uFF0C\u66FE\u7ECF\u8FDE\u63A5\u8FC7\u4E00\u4E9B\u7B49\u5F85\u63A5\u6536\u7684\u4EBA\u3002\u5B83\u4EEC\u73B0\u5728\u4E0D\u518D\u5B58\u5728\u3002\r\n\r\n\u60A8\u6216\u8BB8\u8FD8\u6CE8\u610F\u5230\uFF0C\u60A8\u5728\u8DEF\u9014\u4E2D\u53EF\u80FD\u610F\u5916\u83B7\u5F97\u4E86\u4E00\u4E9B\u672A\u5206\u53D1\u7684\u6570\u636E\u5305\u88F9\u3002\u8FD9\u4E9B\u5305\u88F9\u5728\u7CFB\u7EDF\u4E2D\u88AB\u6807\u8BB0\u4E3A\u201C\u672A\u9001\u8FBE\u201D\uFF0C\u6536\u4EF6\u5730\u5740\u5927\u591A\u5DF2\u5931\u6548\u3002\u5982\u679C\u60A8\u5DF2\u643A\u5E26\u6B64\u7C7B\u6570\u636E\u5305\u88F9\u5230\u8FBE\u7EC8\u70B9\uFF0C\u7CFB\u7EDF\u5728\u6B64\u63D0\u4F9B\u4E00\u9879\u9009\u62E9\uFF1A\r\n\r\n\u60A8\u53EF\u4EE5\u5C06\u6570\u636E\u5305\u88F9\u7559\u5728\u7EC8\u70B9\u3002\u7CFB\u7EDF\u5C06\u5728\u672C\u6B21\u8FDE\u63A5\u5173\u95ED\u540E\u5C06\u5176\u56DE\u6536\u81F3\u672A\u5206\u53D1\u5185\u5BB9\u4ED3\u5E93\uFF0C\u7B49\u5F85\u4E0B\u4E00\u6B21\u53EF\u80FD\u7684\u5206\u53D1\u673A\u4F1A\u3002\u6216\u8005\uFF0C\u60A8\u53EF\u4EE5\u5C06\u5176\u5E26\u8D70\u3002\u7CFB\u7EDF\u4E0D\u4F1A\u8BE2\u95EE\u60A8\u5E26\u8D70\u4E4B\u540E\u7684\u5904\u7406\u65B9\u5F0F\u3002\u7CFB\u7EDF\u4E0D\u4F1A\u8BB0\u5F55\u60A8\u662F\u5426\u5C06\u5176\u653E\u5728\u4E86\u4EFB\u4F55\u53EF\u4EE5\u88AB\u770B\u89C1\u7684\u5730\u65B9\u3002\r\n\r\n\u65E0\u8BBA\u60A8\u7684\u9009\u62E9\u662F\u4EC0\u4E48\uFF0C\u7CFB\u7EDF\u5728\u6B64\u795D\u60A8\u4E00\u8DEF\u5E73\u5B89\u3002\r\n\r\n\uFF08\u672C\u901A\u544A\u53D1\u9001\u540E\uFF0C\u7CFB\u7EDF\u5C06\u572810\u79D2\u5185\u5173\u95ED\u8FDE\u63A5\u3002\u5012\u8BA1\u65F6\uFF1A10\uFF0C9\uFF0C8\u2014\u2014\uFF09"
